// jenkins/Jenkinsfile
// CI/CD Pipeline — Farmer Crop Price Predictor
// Builds and deploys via docker-compose with GitHub webhook integration

pipeline {
    agent any

    environment {
        COMPOSE_PROJECT_NAME = "crop-predictor"
        DEPLOY_DIR = "${WORKSPACE}/deployment"
        TIMESTAMP = sh(script: "date +%Y%m%d_%H%M%S", returnStdout: true).trim()
    }

    options {
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '10'))
        timeout(time: 45, unit: 'MINUTES')
        timestamps()
    }

    triggers {
        // GitHub webhook trigger - automatic on push
        githubPush()
    }

    stages {
        // ── Stage 1: Checkout Code ─────────────────────────────────────────
        stage('📥 Checkout Code') {
            steps {
                echo "═════════════════════════════════════════"
                echo "🔄 Checking out latest code from GitHub"
                echo "═════════════════════════════════════════"
                checkout scm
                script {
                    env.GIT_BRANCH = sh(returnStdout: true, script: 'git rev-parse --abbrev-ref HEAD').trim()
                    env.GIT_COMMIT_SHORT = sh(returnStdout: true, script: 'git rev-parse --short HEAD').trim()
                    env.GIT_COMMIT_MSG = sh(returnStdout: true, script: 'git log -1 --pretty=%B').trim()
                }
                echo "✅ Branch: ${GIT_BRANCH}"
                echo "✅ Commit: ${GIT_COMMIT_SHORT}"
                echo "✅ Message: ${GIT_COMMIT_MSG}"
            }
        }

        // ── Stage 2: Build Backend Image ──────────────────────────────────
        stage('🔨 Build Backend') {
            steps {
                echo "═════════════════════════════════════════"
                echo "🐳 Building Backend Docker Image"
                echo "═════════════════════════════════════════"
                script {
                    sh '''
                        cd backend
                        docker build -t crop-predictor-backend:${GIT_COMMIT_SHORT} .
                        docker tag crop-predictor-backend:${GIT_COMMIT_SHORT} crop-predictor-backend:latest
                        echo "✅ Backend image built successfully"
                    '''
                }
            }
        }

        // ── Stage 3: Build Frontend Image ─────────────────────────────────
        stage('🔨 Build Frontend') {
            steps {
                echo "═════════════════════════════════════════"
                echo "🐳 Building Frontend Docker Image"
                echo "═════════════════════════════════════════"
                script {
                    sh '''
                        cd frontend
                        docker build -t crop-predictor-frontend:${GIT_COMMIT_SHORT} .
                        docker tag crop-predictor-frontend:${GIT_COMMIT_SHORT} crop-predictor-frontend:latest
                        echo "✅ Frontend image built successfully"
                    '''
                }
            }
        }

        // ── Stage 4: Deploy with Docker Compose ──────────────────────────
        stage('🚀 Deploy') {
            steps {
                echo "═════════════════════════════════════════"
                echo "🚀 Deploying with docker-compose"
                echo "═════════════════════════════════════════"
                script {
                    sh '''
                        # Create deployment directory
                        mkdir -p ${DEPLOY_DIR}
                        cp docker-compose.yml ${DEPLOY_DIR}/

                        # Stop old containers gracefully
                        echo "⏹️  Stopping old containers..."
                        cd ${WORKSPACE}
                        docker-compose down --remove-orphans || true

                        # Start new containers
                        echo "▶️  Starting new containers..."
                        docker-compose up -d

                        # Wait for services
                        sleep 10

                        # Show running containers
                        echo "📊 Running containers:"
                        docker-compose ps

                        echo "✅ Deployment completed successfully"
                    '''
                }
            }
        }

        // ── Stage 5: Health Checks ────────────────────────────────────────
        stage('✅ Health Checks') {
            steps {
                echo "═════════════════════════════════════════"
                echo "🏥 Running health checks"
                echo "═════════════════════════════════════════"
                script {
                    sh '''
                        # Wait for services to be ready
                        echo "⏳ Waiting for services to be ready..."
                        for i in {1..30}; do
                            if curl -s http://localhost:3000 > /dev/null 2>&1 && \
                               curl -s http://localhost:5000 > /dev/null 2>&1; then
                                echo "✅ All services are healthy!"
                                break
                            fi
                            echo "Attempt $i/30 - Services starting..."
                            sleep 2
                        done

                        echo "📊 Container logs:"
                        docker-compose logs --tail=20
                    '''
                }
            }
        }

        // ── Stage 6: Cleanup ──────────────────────────────────────────────
        stage('🧹 Cleanup') {
            steps {
                echo "═════════════════════════════════════════"
                echo "🧹 Cleaning up unused Docker resources"
                echo "═════════════════════════════════════════"
                sh '''
                    docker image prune -f --filter "dangling=true" || true
                    echo "✅ Cleanup completed"
                '''
            }
        }
    }

    post {
        success {
            script {
                echo "╔════════════════════════════════════════╗"
                echo "║ ✅ BUILD & DEPLOYMENT SUCCESSFUL       ║"
                echo "║ Build #${BUILD_NUMBER}                 ║"
                echo "║ Commit: ${GIT_COMMIT_SHORT}            ║"
                echo "╚════════════════════════════════════════╝"
            }
        }
        failure {
            script {
                echo "╔════════════════════════════════════════╗"
                echo "║ ❌ BUILD FAILED                         ║"
                echo "║ Build #${BUILD_NUMBER}                 ║"
                echo "║ Check console output for details       ║"
                echo "╚════════════════════════════════════════╝"
            }
        }
        always {
            script {
                echo "Pipeline execution completed at $(date)"
            }
        }
    }
}
